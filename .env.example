# FastNumeric Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ: cp .env.example .env

# Port ที่เปิดเว็บ frontend บนเครื่อง host (Docker Compose)
FRONTEND_PORT=8080

# CORS: origin ที่อนุญาต (คั่นด้วยจุลภาค, * = ทั้งหมด)
CORS_ORIGIN=*

# สำหรับรันแบบปกติ (ไม่ใช้ Docker) — ฝั่ง client
# Vite dev server จะ proxy หรือเรียกตรงไปที่ URL นี้
VITE_API_URL=http://localhost:4000/api

# สำหรับรัน backend แบบปกติ
PORT=4000
# DB_PATH ถ้าไม่กำหนด จะเก็บที่ server/data/fastnumeric.sqlite
# DB_PATH=./data/fastnumeric.sqlite
